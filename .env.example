# JumpServer MCP 环境配置

# JumpServer REST API 地址
jumpserver_url=http://your-jumpserver-host
# 可选覆盖；为空时分别使用 <jumpserver_url>/api/v1 与 <jumpserver_url>/api/swagger.json
api_base_url=
swagger_url=

# JumpServer API 认证：优先使用 Access Key，其次使用 Bearer Token
# Access Key 获取方式：JumpServer Web → 个人信息 → Access Key
access_key_id=your-access-key-id
access_key_secret=your-access-key-secret
# Bearer Token（临时，1 天过期）
# api_token=your-bearer-token

# 组织 ID（可选；配置后作为 X-JMS-ORG 请求头发送）
jms_org_id=

# 保护 MCP HTTP 接口的 API Key（可选）
api_key=

# JumpServer SSH 网关（用于 SSH 命令与 SFTP 工具）
# 注意：SSH 网关就是 JumpServer 自身，直接使用 JumpServer 的登录账号密码
# 连接格式：{gateway_user}@{system_user}@{asset_ip}，通过 JumpServer 的 2222 端口连接
ssh_gateway_host=your-ssh-gateway-host
ssh_gateway_port=2222
ssh_gateway_username=your-gateway-username
ssh_gateway_password=your-gateway-password
ssh_gateway_private_key_path=
ssh_gateway_known_hosts_path=
default_system_user=root

# SSH 连接池
ssh_connect_timeout=30
ssh_command_timeout=30
ssh_pool_max_connections=10
ssh_pool_idle_timeout=1500
ssh_health_check_interval=60

# SSH 命令策略：none / blacklist / whitelist
ssh_command_policy_mode=none
ssh_command_policy_patterns=

# SSH/SFTP 限制
max_command_output_bytes=1048576
max_sftp_upload_bytes=10485760
max_sftp_download_bytes=10485760
max_sftp_list_entries=1000
mcp_worker_threads=8

# 服务器端口
server_port=8099

# 日志级别
log_level=INFO
debug=false
