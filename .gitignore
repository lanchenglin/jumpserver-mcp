# ============================================================
#  通用 — 所有项目必须包含
# ============================================================

# === 敏感配置 ===
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.local
*.secret
credentials.json
service-account*.json
config.local.yaml
config.local.json
config.local.toml
config.local.ini
config.private.yaml
config.private.json
config.private.toml
config.private.ini
# 保留 template 供参考
!config.yaml.template
!config.json.template

# === 密钥和证书（零容忍） ===
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
id_ecdsa
*.pub          # 公钥看情况，私密环境建议也排除
ssh_config
known_hosts
*.crt          # 自签名证书
*.ca-bundle

# === AI / 工具链 ===
.claude/
.omc/
