    "/ops/command-executions/": {
      "post": {
        "operationId": "ops_command_executions_create",
        "summary": "Execute command",
        "description": "Execute a command on assets",
        "requestBody": {
          "content": {"application/json": {"schema": {
            "type": "object",
            "required": ["run_as", "hosts", "command"],
            "properties": {
              "run_as": {"type": "string", "description": "System user ID"},
              "hosts": {"type": "array", "items": {"type": "string"}, "description": "Asset IDs"},
              "command": {"type": "string"}
            }
          }}}
        },
        "responses": {"201": {"description": "Created"}}
      }
    },
